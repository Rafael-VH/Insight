    { "dot": "cyan", "title": "Pipeline OCR principal", "items": [
      "El controller dispara OcrBloc (ProcessImageEvent) y recibe OcrResult",
      "StatsUploadController invoca MlbbParser y MlbbValidator directamente",
      "UploadBloc solo guarda y dispara el reload de HistoryBloc (BLoC → BLoC)"
    ] },
    { "dot": "emerald", "title": "Persistencia 100% local", "items": [
      "SharedPreferences guarda stats_collections, ajustes y tema",
      "HistoryRepositoryImpl reutiliza el LocalStorageDataSource de upload",
      "Sin red ni backend: todo el procesamiento ocurre en el dispositivo"
    ] },
    { "dot": "violet", "title": "Convenios de arquitectura", "items": [
      "Clean Architecture por feature: data · domain · presentation",
      "flutter_bloc 9 + get_it: 6 BLoCs inyectados desde main.dart (di.sl)",
